# Server-side only. Do not expose these values to the browser.
OWNER_USERNAME=arpimc zone
OWNER_CALCULATOR_CODE=replace-with-production-only-code
OWNER_PASSWORD_HASH=scrypt$replace-with-generated-salt$replace-with-generated-hash
OWNER_SESSION_SECRET=replace-with-a-long-random-secret
GITHUB_TOKEN=replace-with-a-fine-grained-token-with-contents-write
GITHUB_OWNER=ppr942731-ship-it
GITHUB_REPO=arpimc
GITHUB_BRANCH=main
# Firebase Admin — server-side only; do not expose the private key.
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CLIENT_EMAIL=replace-with-firebase-admin-client-email
FIREBASE_PRIVATE_KEY=replace-with-firebase-private-key
# Firebase Web config — public values, served only when complete.
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key
FIREBASE_WEB_AUTH_DOMAIN=replace-with-firebase-auth-domain
FIREBASE_WEB_DATABASE_URL=replace-with-firebase-database-url-if-used
FIREBASE_WEB_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_WEB_STORAGE_BUCKET=replace-with-firebase-storage-bucket
FIREBASE_WEB_MESSAGING_SENDER_ID=replace-with-firebase-messaging-sender-id
FIREBASE_WEB_APP_ID=replace-with-firebase-web-app-id
FIREBASE_WEB_MEASUREMENT_ID=replace-with-firebase-measurement-id
# Allow only this Firebase identity to create the existing owner session.
FIREBASE_OWNER_UID=replace-with-owner-firebase-uid
FIREBASE_OWNER_EMAIL=replace-with-owner-firebase-email
